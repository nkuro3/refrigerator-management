# Supabase のダッシュボード（Project Settings → API）から取得
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon または publishable key>
# Web 版のプッシュ通知用（VAPID の公開鍵。README の手順で作成）
EXPO_PUBLIC_VAPID_PUBLIC_KEY=<application server key>
EXPO_PUBLIC_WEB_URL=https://fridge-app-eem.pages.dev
